# Frontend (Next.js). Copy to .env.local and fill in.
# Supabase dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# NestJS backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Show the /debug-calc page and nav link (leave unset in production)
# NEXT_PUBLIC_ENABLE_DEBUG_TOOLS=true

# Playwright e2e only (tests/e2e). Runs against the real Supabase project.
TEST_USER_EMAIL=testuser@dummydomain.org
TEST_USER_PASSWORD=<test user password>
# Optional: lets the e2e setup create the test user automatically
# SUPABASE_SERVICE_ROLE_KEY=<service role key>
