# NestJS backend. Copy to backend/.env and fill in.
# Use the DEV Supabase project here (vibefc-dev). Production values live only in the
# deployment's environment settings. See backend/SUPABASE_SETUP.md.
# Supabase dashboard → Project Settings → API

PORT=3001
NODE_ENV=development

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key>
# Server-only. Used for member invitations and invite claiming. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
SUPABASE_INVITE_REDIRECT_TO=http://localhost:3000/auth/callback

# Optional flags
# CALC_ENGINE_VERBOSE_LOGS=true      # per-node calculation traces
# ENABLE_TEST_AUTH_ENDPOINT=true     # mounts /test-auth (set in the process env, not here)
